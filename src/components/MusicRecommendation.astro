---
import { Disc3 } from '@lucide/svelte';
import { render, type CollectionEntry } from 'astro:content';
import {
	siApplemusic,
	siBandcamp,
	siSpotify,
	siTidal,
	siYoutubemusic,
} from 'simple-icons';
import {
	streamingServices,
	type StreamingServiceKey,
} from '../data/musicStreaming';
import { formatDate } from '../utils/date';

interface Props {
	recommendation: CollectionEntry<'music'>;
}

const { recommendation } = Astro.props;
const { Content } = await render(recommendation);
const { data } = recommendation;

const icons: Partial<Record<StreamingServiceKey, { path: string }>> = {
	spotify: siSpotify,
	bandcamp: siBandcamp,
	appleMusic: siApplemusic,
	youtubeMusic: siYoutubemusic,
	tidal: siTidal,
};

const streamingLinks = streamingServices.flatMap(({ key, label }) => {
	const href = data.streaming?.[key];
	return href ? [{ key, label, href, icon: icons[key] }] : [];
});

function dateValue(date: Date) {
	return date.toISOString().slice(0, 10);
}
---

<article
	id={recommendation.id}
	class="music-recommendation relative scroll-mt-6 overflow-hidden rounded-sm border border-neutral-300/80 bg-white/25 p-5 pt-6 shadow-[0_8px_30px_rgb(0_0_0/0.06)] sm:p-6 sm:pt-7 dark:border-white/15 dark:bg-black/10 dark:shadow-[0_8px_30px_rgb(0_0_0/0.18)]"
>
	<div
		class="music-recommendation-accent absolute inset-x-0 top-0 h-1 bg-[linear-gradient(90deg,var(--heading-secondary-start),var(--heading-secondary-end))]"
		aria-hidden="true"
	>
	</div>

	<header class="flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
		<div>
			<h2 class="section-heading">
				<a class="text-link" href={data.mbAlbumUrl}>{data.album}</a>
			</h2>
			<p class="mt-1 text-neutral-700 dark:text-neutral-300">
				{
					data.artistUrl ? (
						<a class="text-link" href={data.artistUrl}>
							{data.artist}
						</a>
					) : (
						data.artist
					)
				}
			</p>
		</div>

		<dl
			class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-neutral-500 dark:text-neutral-400"
		>
			<div>
				<dt class="font-medium text-neutral-700 dark:text-neutral-300">
					Released
				</dt>
				<dd>
					<time datetime={dateValue(data.releaseDate)}
						>{formatDate(data.releaseDate)}</time
					>
				</dd>
			</div>
			<div>
				<dt class="font-medium text-neutral-700 dark:text-neutral-300">
					Reviewed
				</dt>
				<dd>
					<time datetime={dateValue(data.reviewed)}
						>{formatDate(data.reviewed)}</time
					>
				</dd>
			</div>
		</dl>
	</header>

	<div
		class="post-prose prose prose-neutral mt-5 max-w-none border-t border-neutral-200 pt-5 text-neutral-700 dark:prose-invert dark:border-white/10 dark:text-neutral-300"
	>
		<Content />
	</div>

	{
		streamingLinks.length > 0 && (
			<ul
				class="streaming-links mt-5 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-neutral-200 pt-4 dark:border-white/10"
				aria-label="Streaming links"
			>
				{streamingLinks.map(({ label, href, icon }) => (
					<li>
						<a
							class="text-link inline-flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400"
							href={href}
						>
							{icon ? (
								<svg
									class="size-4 fill-current"
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path d={icon.path} />
								</svg>
							) : (
								<Disc3 aria-hidden="true" size={17} strokeWidth={2} />
							)}
							{label}
						</a>
					</li>
				))}
			</ul>
		)
	}
</article>
