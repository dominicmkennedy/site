---
import type { CollectionEntry } from 'astro:content';
import { formatShortDate } from '../utils/date';

type Post = CollectionEntry<'blog'>;

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="divide-y divide-neutral-200 dark:divide-white/10">
	{
		posts.map((post) => (
			<li class="py-6 first:pt-0">
				<a class="group block" href={`/blog/${post.id}/`}>
					<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
						<h2 class="section-heading group-hover:underline group-hover:underline-offset-4">
							{post.data.title}
						</h2>
						<time
							class="text-sm text-neutral-500 dark:text-neutral-400"
							datetime={post.data.published.toISOString()}
						>
							{formatShortDate(post.data.published)}
						</time>
					</div>
					<p class="mt-2 text-neutral-600 dark:text-neutral-400">
						{post.data.description}
					</p>
				</a>
			</li>
		))
	}
</ul>
