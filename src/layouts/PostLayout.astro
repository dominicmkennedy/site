---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/date';
import BaseLayout from './BaseLayout.astro';

type Post = CollectionEntry<'blog'>;

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	feedHref="/blog/rss.xml"
>
	<article class="content-page content-container">
		<header
			class="post-header border-b border-neutral-200 dark:border-white/10"
		>
			<h1 class="page-heading text-3xl sm:text-4xl">{post.data.title}</h1>
			<p class="mt-3 text-neutral-600 dark:text-neutral-400">
				<time datetime={post.data.published.toISOString()}>
					{formatDate(post.data.published)}
				</time>
			</p>
		</header>
		<div class="post-prose prose prose-neutral max-w-none dark:prose-invert">
			<slot />
		</div>
	</article>
</BaseLayout>
