---
import { getCollection } from 'astro:content';
import FeedLink from '../../components/FeedLink.astro';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---

<BaseLayout title="Blog" feedHref="/blog/rss.xml">
	<section class="index-page content-container">
		<div class="mb-6 flex items-center justify-between gap-4">
			<h1 class="page-heading text-3xl">Blog</h1>
			<FeedLink href="/blog/rss.xml" label="Blog" />
		</div>
		<PostList {posts} />
	</section>
</BaseLayout>
