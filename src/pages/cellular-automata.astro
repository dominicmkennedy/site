---
import CellularAutomata from '../components/CellularAutomata.svelte';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="2D Cellular Automata"
	description="Cellular automata generated with Rust and WebAssembly."
>
	<article
		class="mx-auto flex w-full flex-col px-4 py-6 sm:px-6 lg:h-full lg:min-h-0 lg:overflow-hidden"
	>
		<header>
			<h1 class="page-heading text-3xl sm:text-4xl">2D Cellular Automata</h1>
		</header>

		<CellularAutomata client:only="svelte" />
	</article>
</BaseLayout>
